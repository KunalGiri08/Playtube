# Backend Environment Configuration Example
# Copy this file to .env and replace placeholders with your actual values

PORT=8000
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173

# Cloudinary Storage Configuration
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret

# JWT Secret for authentication tokens
JWT_SECRET=your_strong_random_jwt_secret

# Email service for OTP / password reset
USER_EMAIL=your_email@gmail.com
USER_PASSWORD=your_gmail_app_password

# Google Gemini API Key for AI features (search & filtering)
GEMINI_API_KEY=your_gemini_api_key
